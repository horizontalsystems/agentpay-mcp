# Source this from OpenClaw / Docker shell profile (persistent volume under /home/node).
# Example: echo 'source /home/node/.openclaw/agentpay-mcp/openclaw.env' >> ~/.bashrc

# Persistent paths (mount these volumes in Docker)
export OPENCLAW_HOME="${OPENCLAW_HOME:-/home/node/.openclaw}"
export AGENTPAY_MCP_ROOT="${AGENTPAY_MCP_ROOT:-$OPENCLAW_HOME/agentpay-mcp}"
export MCPORTER_CONFIG="${MCPORTER_CONFIG:-$OPENCLAW_HOME/mcporter/mcporter.json}"
export AGENTPAY_BACKEND_URL="${AGENTPAY_BACKEND_URL:-http://206.189.229.113:3000}"
export AGENTPAY_AGENT_ID="${AGENTPAY_AGENT_ID:-agent_123}"

# mcporter installed into persistent prefix (not global npm)
export MCPORTER_PREFIX="${MCPORTER_PREFIX:-$OPENCLAW_HOME/tools/mcporter}"
export PATH="$MCPORTER_PREFIX/node_modules/.bin:$PATH"

{
  "my_custom_api": {
    "label": "My Custom x402 API",
    "url": "https://api.example.com/v1/resource",
    "method": "POST",
    "headers": { "content-type": "application/json" },
    "bodyFromArgs": true,
    "argsHint": "{ \"key\": \"value\" } — entire object is sent as JSON body"
  },
  "genvox_sentiment": {
    "label": "GenVox Sentiment",
    "url": "https://api.genvox.io/v1/sentiment/${token}",
    "method": "GET",
    "argsHint": "{ \"token\": \"ETH\" } — substitutes ${token} in the URL"
  }
}

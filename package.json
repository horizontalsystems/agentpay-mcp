{
  "name": "agentpay-mcp",
  "version": "2.0.0",
  "description": "AgentPay MCP firewall CLI — configure once, run as stdio MCP server for LLM agents",
  "bin": {
    "agentpay": "./build/index.js"
  },
  "files": [
    "build",
    "SKILL.md",
    "README.md",
    "openclaw.env.example",
    "config",
    "config/x402scan-catalog.json",
    "scripts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "start": "node build/index.js start",
    "setup": "node build/index.js setup",
    "init": "node build/index.js init",
    "install:openclaw": "bash scripts/openclaw-install.sh",
    "verify:openclaw": "bash scripts/openclaw-verify-mcp.sh",
    "catalog:x402scan": "node scripts/build-x402scan-catalog.mjs"
  },
  "keywords": [
    "mcp",
    "agentpay",
    "walletconnect",
    "x402",
    "llm",
    "skills"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/horizontalsystems/agentpay-mcp.git",
    "directory": "mcp-server"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@agentpay/sdk": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.6.0",
    "commander": "^12.1.0",
    "conf": "^13.0.0",
    "inquirer": "^12.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.0.0"
  }
}
